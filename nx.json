{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "dev": {
      "continuous": true,
      "cache": false
    },
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default",
        { "env": "VITE_CATALOG_ENTRY" },
        { "env": "VITE_ORDERS_ENTRY" },
        { "env": "VITE_SHELL_URL" }
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    }
  },
  "analytics": false
}
