{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@lab/platform": ["packages/platform/src/index.ts"],
      "@lab/ui": ["packages/ui/src/index.tsx"]
    }
  },
  "include": ["apps", "packages", "vite.config.ts", "tests/*.ts", "playwright.config.ts"]
}
