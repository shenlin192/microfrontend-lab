{
  "name": "microfrontend-lab", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=24" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs", "start": "node server/local.mjs", "setup": "node scripts/setup.mjs",
    "build": "node scripts/build.mjs", "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs", "test:e2e": "playwright test",
    "release": "node scripts/release.mjs", "rollback": "node scripts/rollback.mjs",
    "deploy:desktop": "node scripts/download.mjs", "cloud:setup": "node scripts/cloud.mjs setup",
    "cloud:deploy": "node scripts/cloud.mjs deploy", "cloud:rollback": "node scripts/cloud.mjs rollback"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1", "@module-federation/enhanced": "2.9.2" },
  "devDependencies": {
    "vite": "8.3.5", "@vitejs/plugin-react": "latest", "@module-federation/vite": "1.23.5",
    "typescript": "~5.9.3", "@types/react": "^19.2.0", "@types/react-dom": "^19.2.0", "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.0", "wrangler": "^4.45.0"
  }
}
